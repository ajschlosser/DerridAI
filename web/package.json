{
  "name": "derridai",
  "private": true,
  "version": "0.81.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:sdk && npm run build:sdk:package && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p sdk/tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:frontend": "npm run typecheck && npm run test:unit && npm run build:ci && npm run build-storybook && npm run test:e2e:legacy && npm run test:e2e && npm run test:e2e:a11y",
    "i18n:defaults": "node ../scripts/export-en-us-defaults.mjs",
    "lint": "eslint src sdk tests .storybook playwright*.config.ts vite.config.ts vite.sdk.config.ts vite.sdk.package.config.ts scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:ci": "npm run build:sdk:check && npm run check:sdk:package && vite build",
    "test:e2e:legacy": "playwright test -c playwright.legacy.config.ts",
    "test:e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "typecheck:tests": "vue-tsc --noEmit -p tsconfig.tests.json",
    "test:workflow": "npm run test:e2e",
    "test:characterization": "npm run test:e2e:legacy",
    "test:accessibility": "npm run test:e2e:a11y",
    "format:repo": "prettier --write .. --config .prettierrc --ignore-path ../.prettierignore",
    "format:repo:check": "prettier --check .. --config .prettierrc --ignore-path ../.prettierignore",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "build:sdk": "tsc --noEmit -p sdk/tsconfig.json && vite build --config vite.sdk.config.ts",
    "build:sdk:package": "tsc -p sdk/tsconfig.build.json && vite build --config vite.sdk.package.config.ts",
    "check:sdk:package": "npm run build:sdk:package && node -e \"import('./sdk/dist/index.js').then((m) => { if (typeof m.createClient !== 'function') process.exit(1); })\" && npm pack ./sdk --dry-run >/dev/null && npm run check:sdk:consumer",
    "check:sdk:consumer": "node scripts/check-sdk-consumer.mjs",
    "build:sdk:check": "npm run build:sdk && git diff --exit-code -- ../api/app/site_assets/derridai-sdk.js",
    "pack:sdk": "npm run build:sdk:package && npm pack ./sdk"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "graphql": "^17.0.2",
    "happy-dom": "^18.0.1",
    "prettier": "3.6.2",
    "storybook": "^10.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  },
  "author": "Aaron John Schlosser, PhD",
  "copyright": "Copyright 2026 Aaron John Schlosser, PhD.",
  "codename": "Fall River"
}
