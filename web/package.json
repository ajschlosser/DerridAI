{
  "name": "derridai",
  "private": true,
  "version": "0.60.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:frontend": "npm run typecheck && npm run test:unit && npm run build && npm run build-storybook && npm run test:e2e"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.6",
    "storybook": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^18.0.1",
    "vitest": "^3.2.4"
  },
  "author": "Aaron John Schlosser, PhD",
  "copyright": "Copyright 2026 Aaron John Schlosser, PhD."
}
