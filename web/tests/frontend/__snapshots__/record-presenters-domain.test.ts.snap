// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`record presenters > builds dashboard and work insight fragments 1`] = `"<div class="dashboard-pie-layout"><div class="dashboard-pie" style="background:conic-gradient(var(--chart-1) 0.00% 75.00%,var(--chart-2) 75.00% 100.00%)" role="img" aria-label="T"></div><div class="dashboard-pie-legend"><button type="button" data-dashboard-work="a"><i style="background:var(--chart-1)"></i><span title="a">a</span><b>75%</b><small>3 V</small></button><button type="button" data-dashboard-work="b"><i style="background:var(--chart-2)"></i><span title="b">b</span><b>25%</b><small>1 V</small></button></div></div>"`;

