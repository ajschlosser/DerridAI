exports[`record presenters > builds dashboard and work insight fragments 3`] = `"<section class="work-insights-panel" aria-label="Work insights"><div class="work-insights-heading"><div><span class="section-label">Work insights</span><h2>Indexed patterns in this work</h2></div><p>Counts are derived from the currently loaded records and use the corpus metadata fields directly.</p></div><div class="work-insights-grid"><article class="work-insight-card "><h3>Top 5 persons mentioned</h3><ol><li class="note">No indexed values in the loaded records.</li></ol></article><article class="work-insight-card "><h3>Top 5 concepts mentioned</h3><ol><li class="note">No indexed values in the loaded records.</li></ol></article><article class="work-insight-card "><h3>Top 5 topics</h3><ol><li><button type="button" data-work-insight-field="topics" data-work-insight-value="a"><span>a</span><b>1</b></button></li><li><button type="button" data-work-insight-field="topics" data-work-insight-value="b"><span>b</span><b>1</b></button></li></ol></article><article class="work-insight-card "><h3>Top 5 discourse targets</h3><ol><li class="note">No indexed values in the loaded records.</li></ol></article><article class="work-insight-card work-insight-card-pie"><h3>Top discourse roles as percentage of recorded roles</h3><p class="note">No indexed values in the loaded records.</p></article></div></section>"`;

