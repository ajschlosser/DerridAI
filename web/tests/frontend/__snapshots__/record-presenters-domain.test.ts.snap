exports[`record presenters > previews RAG evidence 1`] = `
"<details class="rag-evidence-card" >
    <summary><span class="rag-evidence-id">[[Eundefined]]</span><span class="rag-evidence-title"><b>Record NaN</b><small> · p-</small></span><span class="rag-evidence-score"></span></summary>
    <div class="rag-evidence-body">
      <div class="rag-evidence-meta"><div><span>Pages</span><b>p-</b></div></div>
      <div class="rag-evidence-source"><span>Collection</span><b></b><span>Full citation</span><b></b></div>
      
      <div class="tools"><button class="btn tiny" data-copy-rag-record="undefined"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>Copy record</button></div>
      <pre></pre>
    </div>
  </details>"
`;

