# Set these to `id -u` and `id -g` when running Docker Desktop/Compose from WSL.
# Keeping the API container on your host UID prevents root-owned Chroma SQLite files.
HOST_UID=1000
HOST_GID=1000

WEB_BIND=0.0.0.0
API_BIND=127.0.0.1
WEB_PORT=8181
API_PORT=8000

# Authentication / role-based access. The first administrator is created in
# the browser on first launch; no default password is shipped.
AUTH_DB_PATH=/data/.home/derridai-auth.sqlite3
# Keep false for local HTTP/Docker access. Set true when the browser reaches
# DerridAI only through an HTTPS/TLS reverse proxy.
SESSION_COOKIE_SECURE=false
# Per-normalized-username failed-login throttle stored in AUTH_DB_PATH.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_SECONDS=300
# Server-owned provider profiles, annotations, language dictionaries, and durable background-operation state.
SYSTEM_DB_PATH=/data/.home/derridai-system.sqlite3
# Maximum corpus-text characters exposed in a researcher evidence record after
# Edmundson summarization. topics/concepts/persons are used as bonus terms.
RESEARCHER_TEXT_MAX_CHARS=1600

# Shared source upload/download ceiling. The variable keeps its historical PDF
# name for compatibility but is enforced across supported source-media paths.
PDF_MAX_UPLOAD_MB=500
# Maximum metadata-enrichment runs working concurrently across all corpus builds.
ENRICHMENT_MAX_CONCURRENT_RUNS=1

# Read-only GraphQL query façade (docs/GRAPHQL.md). Keep the IDE and
# introspection off outside local development.
GRAPHQL_IDE_ENABLED=false
GRAPHQL_INTROSPECTION_ENABLED=false
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_ALIASES=20
GRAPHQL_MAX_TOKENS=2000

# WebSocket realtime operations plane (docs/REALTIME.md). When disabled the
# browser falls back to periodic REST polling.
REALTIME_ENABLED=true
REALTIME_MAX_CLIENT_MESSAGE_BYTES=65536
REALTIME_MAX_QUEUE_EVENTS=256
REALTIME_REPLAY_EVENTS=512
REALTIME_PROGRESS_MAX_HZ=8
REALTIME_HEARTBEAT_SECONDS=20
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_ALLOWED_ORIGINS=

# "chroma" uses Chroma's local default embedding function.
# "ollama" uses OLLAMA_EMBED_MODEL through the configured Ollama server.
# "precomputed" requires every record to contain an embedding array.
EMBEDDING_PROVIDER=ollama

# Chroma backend. "embedded" (default) is PersistentClient on CHROMA_PATH,
# the same local-first filesystem store DerridAI has always used.
# "http" uses HttpClient against a running Chroma server — either the compose
# profile below or a server already running on the host.
CHROMA_MODE=embedded
# Used only when CHROMA_MODE=http. For the compose profile:
#   docker compose --profile chroma up -d
#   CHROMA_MODE=http
#   CHROMA_BASE_URL=http://chroma:8000
# For a Chroma server on the host:
# CHROMA_BASE_URL=http://host.docker.internal:8001
CHROMA_BASE_URL=http://chroma:8000
CHROMA_TOKEN=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# Host port for the optional chroma compose profile (container still uses 8000).
CHROMA_PORT=8001
# CHROMA_IMAGE_TAG=1.1.0

# For Ollama already running on the host:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# If using: docker compose --profile ollama up --build
# change the previous line to:
# OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=bge-m3:latest
# Inputs per Ollama /api/embed request; large sources are embedded in batches.
OLLAMA_EMBED_BATCH_SIZE=256
API_BATCH_SIZE=128

# Research memory: prior responses steer answers only when graded at least this well (0-10)
RESEARCH_MEMORY_MIN_GRADE=7

# LLM request handling
OLLAMA_CONNECT_TIMEOUT_SECONDS=8
OLLAMA_STATUS_TIMEOUT_SECONDS=3
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_KEEP_ALIVE=10m
LLM_MAX_TEXT_CHARS=50000

# LLM generation safety caps
LLM_METADATA_NUM_PREDICT=768
LLM_TEXT_NUM_PREDICT=4096
LLM_MAX_FIELDS=12
# How a model-proposed value gets source evidence: with_value (default; the model cites blocks in the same answer)
# or backfill (the model proposes the value; blocks are suggested afterwards and always stay pending review).
METADATA_EVIDENCE_MODE=with_value
# Automatic evidence recovery uses a bounded closed-choice LLM only after
# direct support and the semantic/reranking shortlist cannot settle the field.
# Set false to disable that final advisory fallback.
METADATA_EVIDENCE_CASCADE_LLM_ENABLED=true
# Overlap independent, concurrency-safe pipeline branches (the hybrid search's
# semantic and lexical legs). Results and trace order are identical either way;
# off by default.
# PIPELINE_PARALLEL_BRANCHES=false

# OpenAI-compatible provider / FreeLLMAPI
OPENAI_COMPAT_BASE_URL=http://host.docker.internal:3001/v1
OPENAI_COMPAT_MODEL=auto
OPENAI_COMPAT_API_KEY=
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_TIMEOUT_SECONDS=1800

# RAG pipeline defaults
RAG_DEFAULT_K=64
RAG_DEFAULT_FETCH_K=500
RAG_DEFAULT_RERANK_TOP_N=24
RAG_DEFAULT_LAMBDA_MULT=0.7
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MODEL_CACHE=/data/models

RAG_DEFAULT_RRF_K=60
RAG_DEFAULT_QUERY_NUM_PREDICT=768
RAG_DEFAULT_RECORD_CHAR_LIMIT=12000
RAG_DEFAULT_TOTAL_CHAR_LIMIT=120000

# Ollama RAG application-side concurrency gate
RAG_OLLAMA_MAX_CONCURRENT=1
RAG_AUTO_GRADE_MAX_ATTEMPTS=2
RAG_AUTO_GRADE_RETRY_DELAY_SECONDS=1.5

# Optional Storybook frontend-development server (docker compose --profile dev up storybook)
STORYBOOK_BIND=127.0.0.1
STORYBOOK_PORT=6006

# Optional. If unset, Docker reads the commit from .git during image build.
# GIT_COMMIT=

# Document Intelligence. spaCy (in the API) covers every language; install more
# languages under Settings -> System -> Language packs. The optional English-only
# BookNLP worker runs with --profile document-nlp; see docs/DOCUMENT_INTELLIGENCE.md.
# DOCUMENT_NLP_BASE_URL=http://document-nlp:8090
# DOCUMENT_NLP_LANGUAGES=en
# DOCUMENT_NLP_BASE_URL_FR=
# BOOKNLP_ENTITY_MODEL=/models/booknlp/entities_google_bert_uncased_L-6_H-768_A-12-v1.0.model
# BOOKNLP_COREF_MODEL=/models/booknlp/coref_google_bert_uncased_L-12_H-768_A-12-v1.0.model
# BOOKNLP_QUOTE_MODEL=/models/booknlp/speaker_google_bert_uncased_L-12_H-768_A-12-v1.0.1.model
